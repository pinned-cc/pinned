{
  "manifest_version": 3,
  "name": "Pinned",
  "short_name": "Pinned",
  "version": "1.0.0",
  "description": "Save the page you are on to your own Pinned bookmarks server.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Save to Pinned",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "storage", "contextMenus"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the save popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@pinned.cc",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
