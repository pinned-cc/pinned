 "html": "<div class=\"lone-box\">\n  <svg class=\"lone-mark\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"64\" height=\"64\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <linearGradient id=\"lm-bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#2c2c30\"></stop><stop offset=\"1\" stop-color=\"#0d0d0f\"></stop></linearGradient>\n    <radialGradient id=\"lm-glow\" cx=\".5\" cy=\".12\" r=\".7\"><stop offset=\"0\" stop-color=\"#ffffff\" stop-opacity=\".16\"></stop><stop offset=\"1\" stop-color=\"#ffffff\" stop-opacity=\"0\"></stop></radialGradient>\n    <linearGradient id=\"lm-cardTop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ffffff\"></stop><stop offset=\"1\" stop-color=\"#ebe7dc\"></stop></linearGradient>\n    <linearGradient id=\"lm-card2\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#e6e2d7\"></stop><stop offset=\"1\" stop-color=\"#cfcabd\"></stop></linearGradient>\n    <linearGradient id=\"lm-card3\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#cdc8bb\"></stop><stop offset=\"1\" stop-color=\"#b3ada0\"></stop></linearGradient>\n    <linearGradient id=\"lm-card4\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#b1ab9e\"></stop><stop offset=\"1\" stop-color=\"#968f82\"></stop></linearGradient>\n    <linearGradient id=\"lm-fav\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#8fe3b8\"></stop><stop offset=\"1\" stop-color=\"#2fb87a\"></stop></linearGradient>\n    <linearGradient id=\"lm-strip\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#1b1a17\" stop-opacity=\".05\"></stop><stop offset=\"1\" stop-color=\"#1b1a17\" stop-opacity=\".09\"></stop></linearGradient>\n    <radialGradient id=\"lm-pinHead\" cx=\".35\" cy=\".3\" r=\".8\"><stop offset=\"0\" stop-color=\"#b9f0d2\"></stop><stop offset=\".45\" stop-color=\"#5fd39a\"></stop><stop offset=\"1\" stop-color=\"#1f8a5c\"></stop></radialGradient>\n    <linearGradient id=\"lm-needle\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#f4f6f9\"></stop><stop offset=\".5\" stop-color=\"#8d96a5\"></stop><stop offset=\"1\" stop-color=\"#3a414e\"></stop></linearGradient>\n    <linearGradient id=\"lm-tackHead\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#b8860b\"></stop><stop offset=\".45\" stop-color=\"#e0a921\"></stop><stop offset=\"1\" stop-color=\"#8a6508\"></stop></linearGradient>\n    <linearGradient id=\"lm-tackTop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f3c74a\"></stop><stop offset=\"1\" stop-color=\"#d9a21b\"></stop></linearGradient>\n    <linearGradient id=\"lm-tackNeck\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#9c7210\"></stop><stop offset=\".5\" stop-color=\"#d9a21b\"></stop><stop offset=\"1\" stop-color=\"#7a5806\"></stop></linearGradient>\n    <radialGradient id=\"lm-tackRim\" cx=\".4\" cy=\".35\" r=\".8\"><stop offset=\"0\" stop-color=\"#e9b43a\"></stop><stop offset=\".7\" stop-color=\"#c9900f\"></stop><stop offset=\"1\" stop-color=\"#8a6508\"></stop></radialGradient>\n    <radialGradient id=\"lm-tackDome\" cx=\".38\" cy=\".3\" r=\".8\"><stop offset=\"0\" stop-color=\"#f6cf5c\"></stop><stop offset=\".65\" stop-color=\"#d9a21b\"></stop><stop offset=\"1\" stop-color=\"#a87a0a\"></stop></radialGradient>\n    <clipPath id=\"lm-sq\"><rect x=\"0\" y=\"0\" width=\"256\" height=\"256\" rx=\"58\"></rect></clipPath>\n  </defs>\n  <rect x=\"0\" y=\"0\" width=\"256\" height=\"256\" rx=\"58\" fill=\"url(#lm-bg)\"></rect>\n  <rect x=\"0\" y=\"0\" width=\"256\" height=\"256\" rx=\"58\" fill=\"url(#lm-glow)\"></rect>\n  <rect x=\"1\" y=\"1\" width=\"254\" height=\"254\" rx=\"57\" fill=\"none\" stroke=\"#ffffff\" stroke-opacity=\".10\"></rect>\n  <g clip-path=\"url(#lm-sq)\">\n    <rect x=\"60\" y=\"92\" width=\"144\" height=\"108\" rx=\"16\" fill=\"#000\" fill-opacity=\".10\" transform=\"rotate(-2.5 128 150)\"></rect>\n    <rect x=\"58\" y=\"88\" width=\"144\" height=\"108\" rx=\"15\" fill=\"#000\" fill-opacity=\".14\"></rect>\n    <!-- the stack: three cards behind, each a step up and a little turned, then the top card straight -->\n    <g>\n      <rect x=\"56\" y=\"78\" width=\"144\" height=\"108\" rx=\"14\" fill=\"url(#lm-card4)\" transform=\"rotate(-9 128 150)\"></rect>\n      <rect x=\"56\" y=\"78\" width=\"144\" height=\"108\" rx=\"14\" fill=\"url(#lm-card3)\" transform=\"rotate(-5.5 128 150)\"></rect>\n      <rect x=\"56\" y=\"78\" width=\"144\" height=\"108\" rx=\"14\" fill=\"url(#lm-card2)\" transform=\"rotate(-2.5 128 150)\"></rect>\n    </g>\n    <!-- the top card, the app's bookmark card: favicon, title, address, the strip with the folder dot -->\n    <g>\n      <rect x=\"56\" y=\"78\" width=\"144\" height=\"108\" rx=\"14\" fill=\"url(#lm-cardTop)\"></rect>\n      <rect x=\"56\" y=\"78\" width=\"144\" height=\"108\" rx=\"14\" fill=\"none\" stroke=\"#ffffff\" stroke-opacity=\".8\"></rect>\n      <rect x=\"55.5\" y=\"77.5\" width=\"145\" height=\"109\" rx=\"14.5\" fill=\"none\" stroke=\"#1b1a17\" stroke-opacity=\".18\"></rect>\n      <rect x=\"70\" y=\"92\" width=\"30\" height=\"30\" rx=\"8\" fill=\"url(#lm-fav)\"></rect>\n      <rect x=\"76.5\" y=\"98.5\" width=\"7.5\" height=\"7.5\" rx=\"2\" fill=\"#fff\"></rect><rect x=\"86\" y=\"98.5\" width=\"7.5\" height=\"7.5\" rx=\"2\" fill=\"#fff\" fill-opacity=\".6\"></rect>\n      <rect x=\"76.5\" y=\"108\" width=\"7.5\" height=\"7.5\" rx=\"2\" fill=\"#fff\" fill-opacity=\".6\"></rect><rect x=\"86\" y=\"108\" width=\"7.5\" height=\"7.5\" rx=\"2\" fill=\"#fff\" fill-opacity=\".6\"></rect>\n      <rect x=\"70\" y=\"132\" width=\"74\" height=\"9\" rx=\"4.5\" fill=\"#1b1a17\" fill-opacity=\".82\"></rect>\n      <rect x=\"70\" y=\"147\" width=\"96\" height=\"6\" rx=\"3\" fill=\"#1b1a17\" fill-opacity=\".28\"></rect>\n      <path d=\"M56 166 H200 V172 a14 14 0 0 1 -14 14 H70 a14 14 0 0 1 -14 -14 z\" fill=\"url(#lm-strip)\"></path>\n      <path d=\"M56 166 H200\" stroke=\"#1b1a17\" stroke-opacity=\".10\"></path>\n      <circle cx=\"73\" cy=\"176\" r=\"3\" fill=\"#2fb87a\"></circle>\n      <rect x=\"80\" y=\"173.5\" width=\"28\" height=\"5\" rx=\"2.5\" fill=\"#1b1a17\" fill-opacity=\".35\"></rect>\n      <rect x=\"160\" y=\"173.5\" width=\"26\" height=\"5\" rx=\"2.5\" fill=\"#1b1a17\" fill-opacity=\".22\"></rect>\n    </g>\n    <!-- the pin, seen from the top: the round head of a thumbtack pushed through the top right corner -->\n    <g>\n      <ellipse cx=\"184\" cy=\"90\" rx=\"12\" ry=\"5\" fill=\"#000\" fill-opacity=\".18\"></ellipse>\n      <circle cx=\"184\" cy=\"86\" r=\"11\" fill=\"url(#lm-tackRim)\"></circle>\n      <circle cx=\"184\" cy=\"86\" r=\"7.5\" fill=\"url(#lm-tackDome)\"></circle>\n      <circle cx=\"184\" cy=\"86\" r=\"1.6\" fill=\"#5a3f04\" fill-opacity=\".8\"></circle>\n      <ellipse cx=\"181\" cy=\"82.5\" rx=\"3.2\" ry=\"1.8\" fill=\"#ffffff\" fill-opacity=\".45\"></ellipse>\n    </g>\n    <ellipse cx=\"128\" cy=\"222\" rx=\"80\" ry=\"7\" fill=\"#000\" fill-opacity=\".35\"></ellipse>\n  </g>\n</svg>\n  <h1>Pinned</h1>\n  <form id=\"login\" method=\"post\" action=\"/login\">\n    <input type=\"hidden\" name=\"next\" value=\"/\">\n    <!-- A fixed username, so password managers see a full sign in form and fill it. The server reads only the password. -->\n    <label class=\"vh\">Username <input type=\"text\" name=\"username\" value=\"pinned\" autocomplete=\"username\" readonly=\"\" tabindex=\"-1\"></label>\n    <label class=\"fld first\"><span class=\"sh-lbl\">Password</span>\n      <input class=\"fld-in\" type=\"password\" name=\"password\" autocomplete=\"current-password\" required=\"\" autofocus=\"\" enterkeyhint=\"go\" value=\"\"></label>\n    <!-- Shown by the server when the second factor is on (TOTP_SECRET). -->\n    <label class=\"fld\" id=\"login-code\" hidden=\"\"><span class=\"sh-lbl\">Code</span>\n      <input class=\"fld-in\" name=\"code\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"7\" spellcheck=\"false\" enterkeyhint=\"go\" value=\"\"></label>\n    <p class=\"fld-err\" id=\"login-err\" role=\"alert\">Wrong password.</p>\n    <button type=\"submit\" class=\"save\">Log in</button>\n  </form>\n</div>",
