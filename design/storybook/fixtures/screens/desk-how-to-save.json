 "inner": "<svg class=\"sprite\" width=\"0\" height=\"0\" aria-hidden=\"true\">\n<symbol id=\"i-search\" viewBox=\"0 0 20 20\"><circle cx=\"8.75\" cy=\"8.75\" r=\"5.75\"></circle><path d=\"m13 13 4 4\"></path></symbol>\n<symbol id=\"i-all\" viewBox=\"0 0 20 20\"><path d=\"M6 3.75h8a1 1 0 0 1 1 1v11.5l-5-3.25-5 3.25V4.75a1 1 0 0 1 1-1Z\"></path></symbol>\n<symbol id=\"i-inbox\" viewBox=\"0 0 20 20\"><path d=\"M3.5 11.25 5.4 5a1.5 1.5 0 0 1 1.44-1.06h6.32A1.5 1.5 0 0 1 14.6 5l1.9 6.25v3.25a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5Z\"></path><path d=\"M3.5 11.25h3.75l1 1.75h3.5l1-1.75h3.75\"></path></symbol>\n<symbol id=\"i-trash\" viewBox=\"0 0 20 20\"><path d=\"M4 5.75h12M8 5.75V4.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.25M5.5 5.75l.7 9.6a1.5 1.5 0 0 0 1.5 1.4h4.6a1.5 1.5 0 0 0 1.5-1.4l.7-9.6M8.5 9v4.5M11.5 9v4.5\"></path></symbol>\n<symbol id=\"i-import\" viewBox=\"0 0 20 20\"><path d=\"M10 3v9.25M6.75 9 10 12.25 13.25 9M4 13.5v1.75A1.75 1.75 0 0 0 5.75 17h8.5A1.75 1.75 0 0 0 16 15.25V13.5\"></path></symbol>\n<symbol id=\"i-export\" viewBox=\"0 0 20 20\"><path d=\"M10 12.25V3M6.75 6.25 10 3l3.25 3.25M4 13.5v1.75A1.75 1.75 0 0 0 5.75 17h8.5A1.75 1.75 0 0 0 16 15.25V13.5\"></path></symbol>\n<symbol id=\"i-grid\" viewBox=\"0 0 20 20\"><rect x=\"3.5\" y=\"3.5\" width=\"5.25\" height=\"5.25\" rx=\"1.25\"></rect><rect x=\"11.25\" y=\"3.5\" width=\"5.25\" height=\"5.25\" rx=\"1.25\"></rect><rect x=\"3.5\" y=\"11.25\" width=\"5.25\" height=\"5.25\" rx=\"1.25\"></rect><rect x=\"11.25\" y=\"11.25\" width=\"5.25\" height=\"5.25\" rx=\"1.25\"></rect></symbol>\n<symbol id=\"i-list\" viewBox=\"0 0 20 20\"><path d=\"M7.5 5.5h9M7.5 10h9M7.5 14.5h9\"></path><circle cx=\"4\" cy=\"5.5\" r=\".6\"></circle><circle cx=\"4\" cy=\"10\" r=\".6\"></circle><circle cx=\"4\" cy=\"14.5\" r=\".6\"></circle></symbol>\n<symbol id=\"i-sort\" viewBox=\"0 0 20 20\"><path d=\"M6.5 4v12M3.75 13.25 6.5 16l2.75-2.75M13.5 16V4M10.75 6.75 13.5 4l2.75 2.75\"></path></symbol>\n<symbol id=\"i-select\" viewBox=\"0 0 20 20\"><circle cx=\"10\" cy=\"10\" r=\"6.75\"></circle><path d=\"m7.25 10.1 1.9 1.9 3.6-3.75\"></path></symbol>\n<symbol id=\"i-plus\" viewBox=\"0 0 20 20\"><path d=\"M10 4.5v11M4.5 10h11\"></path></symbol>\n<symbol id=\"i-share\" viewBox=\"0 0 20 20\"><path d=\"M10 12.25V3.5M6.75 6.5 10 3.25l3.25 3.25M6.5 9.25h-.75A1.75 1.75 0 0 0 4 11v4.25A1.75 1.75 0 0 0 5.75 17h8.5A1.75 1.75 0 0 0 16 15.25V11a1.75 1.75 0 0 0-1.75-1.75h-.75\"></path></symbol>\n<symbol id=\"i-open\" viewBox=\"0 0 20 20\"><path d=\"M11.5 3.75h4.75V8.5M16 4 9.25 10.75M14 11.75v2.5A1.75 1.75 0 0 1 12.25 16h-6.5A1.75 1.75 0 0 1 4 14.25v-6.5A1.75 1.75 0 0 1 5.75 6h2.5\"></path></symbol>\n<symbol id=\"i-bulb\" viewBox=\"0 0 16 22\"><path style=\"fill:var(--bulb-glass,none);stroke:var(--bulb-rim,currentColor)\" d=\"M8 1.2a6.3 6.3 0 0 0-3.7 11.4c.7.5 1.1 1.3 1.1 2.2v.9h5.2v-.9c0-.9.4-1.7 1.1-2.2A6.3 6.3 0 0 0 8 1.2Z\"></path><path style=\"stroke:var(--bulb-fil,currentColor)\" d=\"M6 10c.7-1.5 1.3-1.5 2 0s1.3 1.5 2 0\"></path><path d=\"M5.6 18h4.8M6.4 20.4h3.2\"></path></symbol><symbol id=\"i-gear\" viewBox=\"0 0 20 20\"><circle cx=\"10\" cy=\"10\" r=\"2.6\"></circle><path d=\"M10 2.5v2.2M10 15.3v2.2M2.5 10h2.2M15.3 10h2.2M4.7 4.7l1.55 1.55M13.75 13.75l1.55 1.55M4.7 15.3l1.55-1.55M13.75 6.25l1.55-1.55\"></path><circle cx=\"10\" cy=\"10\" r=\"5.6\"></circle></symbol>\n<symbol id=\"i-more\" viewBox=\"0 0 20 20\"><circle cx=\"5\" cy=\"10\" r=\".9\"></circle><circle cx=\"10\" cy=\"10\" r=\".9\"></circle><circle cx=\"15\" cy=\"10\" r=\".9\"></circle></symbol>\n<symbol id=\"i-restore\" viewBox=\"0 0 20 20\"><path d=\"M4.25 8.5A6 6 0 1 1 5 13.4\"></path><path d=\"M4 4.5v4h4\"></path></symbol>\n<symbol id=\"i-check\" viewBox=\"0 0 20 20\"><path d=\"m5.5 10.25 3 3 6-6.5\"></path></symbol>\n<symbol id=\"i-clock\" viewBox=\"0 0 20 20\"><circle cx=\"10\" cy=\"10\" r=\"6.75\"></circle><path d=\"M10 6.5V10l2.5 1.5\"></path></symbol>\n<symbol id=\"i-warn\" viewBox=\"0 0 20 20\"><circle cx=\"10\" cy=\"10\" r=\"6.75\"></circle><path d=\"M10 6.5v4.25M10 13.4v.1\"></path></symbol>\n<symbol id=\"i-pin\" viewBox=\"0 0 20 20\"><path d=\"M12.25 3.5 16.5 7.75l-2.5 1-3 3 .25 3-1.5 1.5-6-6 1.5-1.5 3 .25 3-3ZM6.75 13.25 3.5 16.5\"></path></symbol>\n<symbol id=\"i-move\" viewBox=\"0 0 20 20\"><path d=\"M3.5 6.25A1.75 1.75 0 0 1 5.25 4.5h2.6l1.5 1.75h5.4a1.75 1.75 0 0 1 1.75 1.75v6.75a1.75 1.75 0 0 1-1.75 1.75h-9.5A1.75 1.75 0 0 1 3.5 14.75Z\"></path><path d=\"M8 11h4.5M10.75 9.25 12.5 11l-1.75 1.75\"></path></symbol>\n<symbol id=\"i-folder\" viewBox=\"0 0 20 20\"><path d=\"M3.5 6.25A1.75 1.75 0 0 1 5.25 4.5h2.6l1.5 1.75h5.4a1.75 1.75 0 0 1 1.75 1.75v6.75a1.75 1.75 0 0 1-1.75 1.75h-9.5A1.75 1.75 0 0 1 3.5 14.75Z\"></path></symbol><symbol id=\"i-folder-plus\" viewBox=\"0 0 20 20\"><path d=\"M3.5 6.25A1.75 1.75 0 0 1 5.25 4.5h2.6l1.5 1.75h5.4a1.75 1.75 0 0 1 1.75 1.75v6.75a1.75 1.75 0 0 1-1.75 1.75h-9.5A1.75 1.75 0 0 1 3.5 14.75Z\"></path><path d=\"M10 8.75v4.5M7.75 11h4.5\"></path></symbol>\n<symbol id=\"i-edit\" viewBox=\"0 0 20 20\"><path d=\"M12.6 4.4a1.6 1.6 0 0 1 2.3 0l.7.7a1.6 1.6 0 0 1 0 2.3L8 15H5v-3Z\"></path><path d=\"m11.25 5.75 3 3\"></path></symbol>\n<symbol id=\"i-up\" viewBox=\"0 0 20 20\"><path d=\"M10 15.5v-11M5.75 8.75 10 4.5l4.25 4.25\"></path></symbol>\n<symbol id=\"i-down\" viewBox=\"0 0 20 20\"><path d=\"M10 4.5v11M5.75 11.25 10 15.5l4.25-4.25\"></path></symbol>\n<symbol id=\"i-logout\" viewBox=\"0 0 20 20\"><path d=\"M8 4H5.75A1.75 1.75 0 0 0 4 5.75v8.5A1.75 1.75 0 0 0 5.75 16H8M12.5 6.5 16 10l-3.5 3.5M16 10H8\"></path></symbol>\n<symbol id=\"i-back\" viewBox=\"0 0 20 20\"><path d=\"M12.5 4.25 6.75 10l5.75 5.75\"></path></symbol>\n<symbol id=\"i-chev\" viewBox=\"0 0 20 20\"><path d=\"m8 5 5 5-5 5\"></path></symbol>\n<symbol id=\"i-close\" viewBox=\"0 0 20 20\"><path d=\"m5.5 5.5 9 9M14.5 5.5l-9 9\"></path></symbol>\n<symbol id=\"i-lock\" viewBox=\"0 0 20 20\"><rect x=\"4.5\" y=\"9\" width=\"11\" height=\"8\" rx=\"2\"></rect><path d=\"M7 9V6.75a3 3 0 0 1 6 0V9\"></path></symbol>\n<symbol id=\"i-key\" viewBox=\"0 0 20 20\"><circle cx=\"7\" cy=\"13\" r=\"3.25\"></circle><path d=\"m9.4 10.6 6.35-6.35M13.5 6.5l2 2M11.75 8.25l1.5 1.5\"></path></symbol>\n<symbol id=\"i-link\" viewBox=\"0 0 20 20\"><path d=\"M8.6 11.4a3 3 0 0 0 4.24 0l2.4-2.4a3 3 0 0 0-4.24-4.24l-.85.85\"></path><path d=\"M11.4 8.6a3 3 0 0 0-4.24 0l-2.4 2.4a3 3 0 0 0 4.24 4.24l.85-.85\"></path></symbol>\n</svg>\n<main class=\"bm-page\">\n  <a class=\"back\" href=\"/\"><svg class=\"i\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M12.5 4.25 6.75 10l5.75 5.75\"></path></svg>Pinned</a>\n  <h1>How to save</h1>\n  <p class=\"lead\">Keep the page you are on, from any browser.</p>\n\n  <div class=\"seg hs-tabs\" role=\"tablist\" aria-label=\"Device\" style=\"--tab: 1;\">\n    <button type=\"button\" role=\"tab\" id=\"t-iphone\" aria-controls=\"p-iphone\" aria-selected=\"false\" tabindex=\"-1\">iPhone</button>\n    <button type=\"button\" role=\"tab\" id=\"t-mac\" aria-controls=\"p-mac\" aria-selected=\"true\" tabindex=\"0\">Computer</button>\n    <button type=\"button\" role=\"tab\" id=\"t-android\" aria-controls=\"p-android\" aria-selected=\"false\" tabindex=\"-1\">Android</button>\n    <button type=\"button\" role=\"tab\" id=\"t-ext\" aria-controls=\"p-ext\" aria-selected=\"false\" tabindex=\"-1\">Extension</button>\n  </div>\n\n  <!-- iPhone: a Safari bookmark whose address is the Save code -->\n  <section class=\"hs-panel\" id=\"p-iphone\" role=\"tabpanel\" aria-labelledby=\"t-iphone\" hidden=\"\">\n    <ol class=\"hs-steps\">\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">Copy the Save code.</p>\n        <button type=\"button\" class=\"hs-copy\" data-bm-copy=\"\"><span class=\"hs-copy-a\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-link\"></use></svg>Copy the Save code</span><span class=\"hs-copy-b\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-check\"></use></svg>Copied</span></button>\n      </li>\n      <li class=\"hs-step\">\n        <figure class=\"hs-pic\" aria-hidden=\"true\"><div class=\"ios ios-share\">\n          <span class=\"ios-head\"><span class=\"ios-site\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8\" r=\"5.5\"></circle><path d=\"M10.2 5.8 9 9 5.8 10.2 7 7z\"></path></svg></span><span class=\"ios-host\">example.com</span><span class=\"ios-x\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5.5 5.5l5 5M10.5 5.5l-5 5\"></path></svg></span></span>\n          <span class=\"ios-apps\"><span><i></i>AirDrop</span><span><i></i>Messages</span><span><i></i>Mail</span><span><i></i>Notes</span><span><i></i>Reminders</span></span>\n          <span class=\"ios-group\"><span class=\"ios-row\">Copy<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"5\" width=\"8\" height=\"9\" rx=\"1.5\"></rect><path d=\"M3 11V3.5A1.5 1.5 0 0 1 4.5 2H10\"></path></svg></span></span>\n          <span class=\"ios-group\"><span class=\"ios-row\">Add to Reading List<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"4.5\" cy=\"9.5\" r=\"2.5\"></circle><circle cx=\"11.5\" cy=\"9.5\" r=\"2.5\"></circle><path d=\"M7 9.5q1-1 2 0\"></path></svg></span><span class=\"ios-row hot\">Add Bookmark<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 4.5C6.5 3.3 4.5 3 2.5 3.3v9c2-.3 4 0 5.5 1.2 1.5-1.2 3.5-1.5 5.5-1.2v-9C11.5 3 9.5 3.3 8 4.5zM8 4.5v9\"></path></svg></span><span class=\"ios-row\">Add to Favorites<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 2.3l1.8 3.6 4 .6-2.9 2.8.7 4L8 11.4l-3.6 1.9.7-4L2.2 6.5l4-.6z\"></path></svg></span><span class=\"ios-row\">Add to Home Screen<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2.5\" y=\"2.5\" width=\"11\" height=\"11\" rx=\"2.5\"></rect><path d=\"M8 5.5v5M5.5 8h5\"></path></svg></span></span>\n        </div></figure>\n        <p class=\"hs-t\">Tap <b>Share</b>, then <b>Add Bookmark</b>. Name it <b>Save</b>, put it in <b>Favorites</b>.</p>\n      </li>\n      <li class=\"hs-step\">\n        <figure class=\"hs-pic\" aria-hidden=\"true\"><div class=\"ios ios-edit\">\n          <span class=\"ios-bar\"><span class=\"ios-btn\">Cancel</span><b>Edit Bookmark</b><span class=\"ios-btn\">Save</span></span>\n          <span class=\"ios-group ios-form\"><span class=\"ios-fav\"><img src=\"/favicon.svg\" alt=\"\"></span><span class=\"ios-fields\"><span class=\"ios-field\">Save</span><span class=\"ios-field hot mono\">javascript:(function()…<i class=\"ios-caret\"></i></span></span></span>\n          <span class=\"ios-cap\">Location</span>\n          <span class=\"ios-group\"><span class=\"ios-row ios-lead\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 2.3l1.8 3.6 4 .6-2.9 2.8.7 4L8 11.4l-3.6 1.9.7-4L2.2 6.5l4-.6z\"></path></svg>Favorites<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 4l4 4-4 4\"></path></svg></span></span>\n        </div></figure>\n        <p class=\"hs-t\">Open bookmarks, hold <b>Save</b>, tap <b>Edit</b>. Paste the code as its address.</p>\n      </li>\n      <li class=\"hs-step\">\n        <figure class=\"hs-pic\" aria-hidden=\"true\"><div class=\"ios ios-marks\">\n          <span class=\"ios-bar\"><span class=\"ios-btn\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 4l4 4-4 4\"></path></svg></span><b>Favorites</b><span class=\"ios-btn\">Edit</span></span>\n          <span class=\"ios-group\"><span class=\"ios-row ios-lead\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 4.5C6.5 3.3 4.5 3 2.5 3.3v9c2-.3 4 0 5.5 1.2 1.5-1.2 3.5-1.5 5.5-1.2v-9C11.5 3 9.5 3.3 8 4.5zM8 4.5v9\"></path></svg>Docs</span><span class=\"ios-row ios-lead hot\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 4.5C6.5 3.3 4.5 3 2.5 3.3v9c2-.3 4 0 5.5 1.2 1.5-1.2 3.5-1.5 5.5-1.2v-9C11.5 3 9.5 3.3 8 4.5zM8 4.5v9\"></path></svg>Save</span><span class=\"ios-row ios-lead\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 4.5C6.5 3.3 4.5 3 2.5 3.3v9c2-.3 4 0 5.5 1.2 1.5-1.2 3.5-1.5 5.5-1.2v-9C11.5 3 9.5 3.3 8 4.5zM8 4.5v9\"></path></svg>News</span></span>\n        </div></figure>\n        <p class=\"hs-t\">On a page you want to keep: bookmarks, <b>Save</b>.</p>\n      </li>\n    </ol>\n\n    <!-- iCloud Private Relay with a Tailscale address: the page goes through Apple, which cannot reach the tailnet -->\n    <details class=\"hs-fix\">\n      <summary><span class=\"hs-fix-ic\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-warn\"></use></svg></span><span class=\"hs-fix-tt\"><b>Black page, or Not Secure?</b><span>iCloud Private Relay with Tailscale</span></span><svg class=\"i hs-fix-ch\" aria-hidden=\"true\"><use href=\"#i-chev\"></use></svg></summary>\n      <div class=\"hs-fix-in\">\n        <p>Save runs inside the page you are on, and with Private Relay on that page goes through Apple. Apple cannot reach your Tailscale address, so Safari falls back to http and the page stays black. Let Tailscale find the address on your iPhone instead.</p>\n        <ol class=\"hs-fix-steps\">\n          <li>In the Tailscale admin, under <b>Machines</b>, copy your iPhone's address. It starts with 100.</li>\n          <li>Under <b>Access controls</b>, paste this right after the first <code>{</code> and put your iPhone's address in it. Save.\n            <pre class=\"hs-snip\" id=\"relay-snip\">\"nodeAttrs\": [\n  { \"target\": [\"100.x.y.z\"], \"attr\": [\"disable-split-dns-when-no-custom-resolvers\"] }\n],</pre>\n            <button type=\"button\" class=\"hs-copy hs-dl hs-snip-copy\" data-copy=\"relay-snip\"><span class=\"hs-copy-a\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-link\"></use></svg>Copy</span><span class=\"hs-copy-b\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-check\"></use></svg>Copied</span></button></li>\n          <li>On the iPhone, turn Tailscale off and on again.</li>\n        </ol>\n        <p class=\"hs-fix-src\"><a class=\"bm-link\" href=\"https://github.com/tailscale/tailscale/issues/21677\" target=\"_blank\" rel=\"noopener\">The Tailscale issue</a></p>\n      </div>\n    </details>\n    <details class=\"hs-fix\">\n      <summary><span class=\"hs-fix-ic\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-pin\"></use></svg></span><span class=\"hs-fix-tt\"><b>Pinned as your start page</b><span>Which iPhone browsers can do it</span></span><svg class=\"i hs-fix-ch\" aria-hidden=\"true\"><use href=\"#i-chev\"></use></svg></summary>\n      <div class=\"hs-fix-in\">\n        <p>Safari, Chrome and Brave on the iPhone cannot open a page of your own as their start page. Firefox and Vivaldi can. Your Pinned address:</p>\n        <pre class=\"hs-snip\" id=\"home-snip\" data-origin=\"\">http://127.0.0.1:18431</pre>\n        <button type=\"button\" class=\"hs-copy hs-dl hs-snip-copy\" data-copy=\"home-snip\"><span class=\"hs-copy-a\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-link\"></use></svg>Copy</span><span class=\"hs-copy-b\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-check\"></use></svg>Copied</span></button>\n        <ul class=\"hs-fix-steps\">\n          <li><b>Firefox:</b> Menu, Settings, Homepage, Custom URL. Paste the address.</li>\n          <li><b>Vivaldi:</b> Menu, Settings, General. Turn on Display Home Button, pick Specific Site and paste the address. Home then opens Pinned.</li>\n          <li><b>Safari:</b> open Pinned, tap Share, then Add to Favorites. Every new tab shows it as the first tile.</li>\n        </ul>\n      </div>\n    </details>\n  </section>\n\n  <!-- computer: the button dragged into the bookmarks bar -->\n  <section class=\"hs-panel\" id=\"p-mac\" role=\"tabpanel\" aria-labelledby=\"t-mac\">\n    <ol class=\"hs-steps\">\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">Show the bookmarks bar.</p>\n        <p class=\"hs-keys\"><span>Brave, Chrome</span><kbd>Cmd</kbd><kbd>Shift</kbd><kbd>B</kbd></p>\n        <p class=\"hs-keys\"><span>Safari</span>View, Show Favorites Bar</p>\n      </li>\n      <li class=\"hs-step\">\n        <figure class=\"hs-pic\" aria-hidden=\"true\"><div class=\"pv pv-bar\">\n          <span class=\"pv-dots\"><i></i><i></i><i></i></span><span class=\"pv-mark\">Docs</span><span class=\"pv-mark hot\">Save to Pinned</span><span class=\"pv-mark\">News</span>\n        </div></figure>\n        <p class=\"hs-t\">Drag this button into the bar.</p>\n        <p><a class=\"bm-btn\" data-bm=\"\" href=\"javascript:(function(){var u=&quot;http://127.0.0.1:18431/save?url=&quot;+encodeURIComponent(location.href)+'&amp;title='+encodeURIComponent(document.title);var w=window.open(u,'bookmarks-save','width=392,height=544,menubar=no,toolbar=no,location=no');if(!w)location.href=u;})();\"><img class=\"mark\" src=\"/favicon.svg\" alt=\"\" width=\"22\" height=\"22\" draggable=\"false\">Save to Pinned</a></p>\n      </li>\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">On a page you want to keep, click <b>Save to Pinned</b>.</p>\n      </li>\n    </ol>\n  </section>\n\n  <!-- Android: the app on the home screen takes shares -->\n  <section class=\"hs-panel\" id=\"p-android\" role=\"tabpanel\" aria-labelledby=\"t-android\" hidden=\"\">\n    <ol class=\"hs-steps\">\n      <li class=\"hs-step\"><p class=\"hs-t\">Open Pinned in Chrome and add it to the home screen.</p></li>\n      <li class=\"hs-step\">\n        <figure class=\"hs-pic\" aria-hidden=\"true\"><div class=\"pv pv-share\">\n          <span class=\"pv-app\"><i></i>Mail</span><span class=\"pv-app hot\"><i class=\"pin\"></i>Pinned</span><span class=\"pv-app\"><i></i>Notes</span>\n        </div></figure>\n        <p class=\"hs-t\">On any page, tap <b>Share</b> and pick <b>Pinned</b>.</p>\n      </li>\n    </ol>\n  </section>\n\n  <!-- the extension, loaded unpacked -->\n  <section class=\"hs-panel\" id=\"p-ext\" role=\"tabpanel\" aria-labelledby=\"t-ext\" hidden=\"\">\n    <ol class=\"hs-steps\">\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">Download it, unzip it, and keep the folder where it can stay. If it moves, the browser drops the extension.</p>\n        <p><a class=\"hs-copy hs-dl\" href=\"/extras/pinned-extension.zip\" download=\"\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-export\"></use></svg>Download the extension</a></p>\n      </li>\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">Load the folder.</p>\n        <p class=\"hs-keys\"><span>Brave, Chrome, Edge</span>Extensions, Developer mode, Load unpacked</p>\n        <p class=\"hs-keys\"><span>Firefox</span>about:debugging, This Firefox, Load temporary add-on, manifest.json</p>\n        <p class=\"hs-keys hs-ff\" data-ff-note=\"\">Firefox removes it when it quits. After a restart, load it again and give it a new token.</p>\n      </li>\n      <li class=\"hs-step\">\n        <p class=\"hs-t\">In its options, enter your address and <a class=\"bm-link\" href=\"/#tokens\">a token</a>. Allow access to your server when asked.</p>\n      </li>\n      <li class=\"hs-step\">\n        <p class=\"hs-keys\"><span>Open it</span><kbd>Option</kbd><kbd>Shift</kbd><kbd>S</kbd></p>\n        <p class=\"hs-keys\"><span>Windows, Linux</span><kbd>Alt</kbd><kbd>Shift</kbd><kbd>S</kbd></p>\n      </li>\n    </ol>\n  </section>\n\n  <details class=\"hs-code\"><summary>Show the Save code</summary><code data-bm-code=\"\">javascript:(function(){var u=\"http://127.0.0.1:18431/save?url=\"+encodeURIComponent(location.href)+'&amp;title='+encodeURIComponent(document.title);var w=window.open(u,'bookmarks-save','width=392,height=544,menubar=no,toolbar=no,location=no');if(!w)location.href=u;})();</code></details>\n  <button type=\"button\" class=\"back bm-out\" data-a=\"logout\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-logout\"></use></svg>Log out</button>\n</main>\n<div class=\"toasts\" id=\"toasts\"></div>\n<p class=\"vh\" id=\"announce\" role=\"status\" aria-live=\"polite\"></p>\n<script type=\"module\" src=\"/static/js/app.js\"></script>\n\n\n",
