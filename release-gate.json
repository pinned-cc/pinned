{
  "product": "pinned",
  "about": "Release gate config for Pinned, read by bin/release-checks/weekpanda.py in hichem-os through bin/release-gate.py pinned <version> --checks (playbooks/method.md part 7.1). Each check: id, type, mode warn or block. New checks start as warn and move to block after a few clean runs. Method records that hold private notes (claims, items, audits, flow tests) live in hichem-os, not in this public repo; paths starting drafts/, audits/, streams/ or playbooks/ resolve there.",
  "workdir": "/tmp/release-gate-pinned",
  "proof_dir": "docs/proof",
  "hichem_os_prefixes": ["drafts/", "audits/", "streams/", "playbooks/"],
  "checks": [
    {"id": "spec-before-code", "type": "spec_facts", "mode": "warn", "spec": "docs/spec.md",
     "facts": {"name": "(?m)^S1\\.1 Pinned is", "price": "(?i)\\b(free of charge|no price|costs nothing)\\b", "distribution": "ghcr\\.io/pinned-cc/pinned", "what it does not do": "(?m)^## 2\\. Out of scope"}},
    {"id": "claims-fresh", "type": "claims", "mode": "warn", "claims": "drafts/bookmarks-directions/research/claims.md", "spec": "docs/spec.md", "max_days": 30},
    {"id": "items-method", "type": "items", "mode": "warn", "record": "drafts/bookmarks-directions/docs/items.md"},

    {"id": "lesson-checks", "type": "cmd", "mode": "warn", "run": "bash \"$HOME/hichem-os/bin/release-checks/pinned.sh\" pre-push",
     "expect_zero": "(\\d+) warning\\(s\\)\\.", "timeout": 1800,
     "note": "runs on the working tree of the repo, not on the archive: CI run lines, staticcheck, race tests in three zones, govulncheck with the Dockerfile's Go"},
    {"id": "pack-extension", "type": "cmd", "mode": "warn", "run": ["sh", "tools/pack-extension.sh"], "timeout": 300},
    {"id": "tests-3-zones", "type": "tests", "mode": "warn", "run": ["go", "test", "./..."], "zones": ["", "UTC", "America/Los_Angeles"], "timeout": 1800},
    {"id": "upgrade-from-every-release", "type": "cmd", "mode": "warn", "run": ["go", "test", "-count=1", "-run", "Upgrade", "-v", "./internal/store/"],
     "count": "(?m)^\\s*--- PASS: \\S*Upgrade", "count_label": "upgrade tests passed", "timeout": 600},
    {"id": "gitleaks", "type": "gitleaks", "mode": "warn",
     "allow": [{"file": "extras/examples/README.md", "rule": "curl-auth-header", "reason": "the placeholder token tk_your_token in the API examples, judged a false positive in release audits 4 and 5"}]},
    {"id": "semgrep", "type": "semgrep", "mode": "warn", "sets": ["default", "secrets", "golang", "javascript", "dockerfile"],
     "rules": "~/hichem-os/audits/pinned/*/scans/semgrep-rules", "triage": "audits/pinned/*/findings.json"},
    {"id": "commit-trace", "type": "commit_trace", "mode": "warn"},
    {"id": "no-home-path-or-placeholder", "type": "tracked_text", "mode": "warn", "placeholders": "<app>|no name yet|lorem ipsum|TODO: fill|text goes here", "skip": ["release-gate.json"],
     "note": "the word placeholder is left out: the web app uses the HTML placeholder attribute on purpose"},
    {"id": "audit-gate-open", "type": "audit_findings", "mode": "warn", "glob": "audits/pinned/*/findings.json",
     "code_paths": ["cmd", "internal", "web", "extras", "tools", "assets.go", "Dockerfile", "go.mod", "go.sum"],
     "exclude": ["*_test.go", "internal/store/testdata/*", "tools/*.test.*", "tools/ui-test.mjs"]},
    {"id": "flow-test-current", "type": "report_file", "mode": "warn", "glob": "drafts/pinned-*/flow/flow-test-*.md", "version": "changelog"},
    {"id": "real-browser-run", "type": "report_file", "mode": "warn", "glob": "drafts/pinned-*/proof/real-browser-*.md", "version": "changelog"},
    {"id": "image-sbom-attestation", "type": "cmd", "mode": "warn",
     "run": "v=$(sed -n 's/^## \\([0-9][0-9.]*\\).*/\\1/p' CHANGELOG.md | head -1); bash \"$HOME/hichem-os/bin/release-checks/pinned.sh\" image \"$v\"",
     "expect_zero": "(\\d+) warning\\(s\\)\\.", "timeout": 600,
     "note": "after the tag build: both platforms, no email or account name in the build records, SBOMs and provenance on the release, gh attestation verify"},
    {"id": "store-prs-green", "type": "cmd", "mode": "warn", "run": "bash \"$HOME/hichem-os/bin/release-checks/pinned.sh\" stores",
     "expect_zero": "(\\d+) warning\\(s\\)\\.", "timeout": 900},
    {"id": "update-path", "type": "cmd", "mode": "warn", "run": ["grep", "-q", "^\\*\\*Upgrading\\.\\*\\*", "README.md"]},
    {"id": "known-issues-guide", "type": "cmd", "mode": "warn", "run": ["grep", "-q", "^## Known issues", "README.md"],
     "note": "method 7.6: a guide with known issues for anything given to other people"},
    {"id": "report-a-problem", "type": "cmd", "mode": "warn", "wired": false,
     "note": "method 7.6: a Report a Problem export without telemetry; not built in Pinned yet, task [pinned-retro]"}
  ]
}
